{
  "name": "pokemon-unite-all-moves-tracker",
  "version": "1.0.1",
  "description": "Pokémon UNITE 全技能組一勝挑戰追蹤器",
  "main": "electron/main.cjs",
  "author": "barro0625",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tw.barro0625.uniteallmovestracker",
    "productName": "Pokemon Unite Tracker",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "pokemon.json",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pokemon-Unite-Tracker-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "全技能組一勝挑戰"
    }
  }
}
